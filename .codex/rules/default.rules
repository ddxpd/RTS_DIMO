# Project-local rules for the trusted Godot/Blender development toolchain.
#
# Only the fixed PowerShell wrapper entry points are allowed outside the
# sandbox. Raw interpreters, arbitrary executables, GUI launches, and commands
# that are not listed here remain approval-gated.

prefix_rule(
    pattern = ["powershell.exe", "-NoProfile", "-File", "D:\\project\\godot_project\\rts_host_p2p_prototype\\tools\\codex\\run-godot.ps1"],
    decision = "allow",
    justification = "Run the project-pinned Godot wrapper with a fixed project root.",
)

